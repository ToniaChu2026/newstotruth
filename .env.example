# 文章發佈目的地：site = 本專案內建的獨立網站（預設）；wordpress = 寫進 WordPress 草稿
IMPORT_TARGET=site

# 獨立網站設定（IMPORT_TARGET=site）
SITE_NAME=新闻聚焦
SITE_TAGLINE=关注真相 传递希望
# 文章與圖片存放的資料夾；部署到雲端時要掛載成永久磁碟
DATA_DIR=./data

# WordPress 連線（只有 IMPORT_TARGET=wordpress 才需要）
WP_BASE_URL=https://newstotruth.com
WP_USERNAME=ai-importer
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# 可改為 claude-sonnet-5-5 或 claude-haiku-5-5 以降低費用
ANTHROPIC_MODEL=claude-opus-5-5

# 匯入工具登入
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# 伺服器埠號（預設 3000）
PORT=3000
